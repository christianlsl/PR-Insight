# GitHub Personal Access Token (需要 repo 权限)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# API Key (也用于 DeepSeek/Mimo 等兼容接口)
API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 可选: 自定义模型 (默认 claude-sonnet-4-20250514)
# 支持: claude-sonnet-4-20250514, deepseek-chat, deepseek-coder, mimo
# MODEL=claude-sonnet-4-20250514

# 可选: 自定义 API Base URL (用于 DeepSeek/Mimo 等国产模型)
# 示例: https://token-plan-cn.xiaomimimo.com/anthropic
# BASE_URL=
